BOT_TOKEN=123456:replace-me
OWNER_ID=123456789
TIMEZONE=Europe/Riga
# Local dev default is SQLite; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./planner.db

# Optional: natural language + voice understanding. Without it the regex parser is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Local speech-to-text model: tiny | base | small | medium | large-v3 (small ≈ 0.5 GB RAM)
WHISPER_MODEL=small

# Used by docker-compose / backups
POSTGRES_PASSWORD=change-me
R2_BUCKET=
R2_ENDPOINT=
